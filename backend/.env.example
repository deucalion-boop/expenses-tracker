PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase project values from the Connect dialog.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Optional production error monitoring.
SENTRY_DSN=
NODE_ENV=development

# Set in Vercel to authenticate scheduled recurring-transaction processing.
CRON_SECRET=replace-with-a-long-random-value
